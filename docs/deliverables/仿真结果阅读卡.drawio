        <mxCell id="hashguide" value="&lt;b&gt;定位方法&lt;/b&gt;&lt;br&gt;① 按运行文件读取 &lt;code&gt;source.input_path&lt;/code&gt; 与 &lt;code&gt;source.input_sha256&lt;/code&gt;&lt;br&gt;② 在同一文件的 &lt;code&gt;evidence[]&lt;/code&gt; 中查找 &lt;code&gt;kind=input&lt;/code&gt;&lt;br&gt;③ 以完整 &lt;code&gt;sha256&lt;/code&gt; 核对；evidence ID 使用其前 16 位作为后缀" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f5ee;strokeColor=#d7d1c2;align=left;verticalAlign=top;spacing=13;fontColor=#15211d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="610" width="690" height="94" as="geometry"/></mxCell>
